# cognipick 환경 변수 (.env 하나로 관리). 값은 로컬 .env 또는 Render 대시보드에만 입력한다.
# 프런트엔드에 노출되는 변수는 VITE_ 접두어뿐이며, 보안 키는 절대 VITE_ 로 두지 않는다.

# ---------- 로컬 / Render(API) ----------
APP_ENV=development
JWT_SECRET_KEY=            # [Render 필수] JWT 서명 키
ADMIN_SECRET_KEY=          # [Render 필수] 실제 관리자 로그인 키 (백엔드에서만 검증)
ADMIN_EMAIL=admin@cognipick.dev
DATABASE_URL=              # 비우면 SQLite. TiDB: mysql+pymysql://USER:PASS@HOST:4000/cognipick
DB_SSL=true
CORS_ORIGINS=http://localhost:5173,https://cognipick.netlify.app,https://cognipick.onrender.com
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
ENABLE_TEST_LOGIN=true
TEST_USER_PASSWORD=
GEMINI_API_KEY=            # 비우면 규칙 기반 폴백으로 동작
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ---------- Netlify / Render(Static) / 로컬 프런트 ----------
VITE_API_BASE_URL=http://localhost:8000
